# Copy to .env and fill in. Never commit .env.

# Neon (or any Postgres) connection string
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Long random string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# Public base URL of the site (no trailing slash)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Vercel Blob token (needed in production; local dev falls back to ./media)
BLOB_READ_WRITE_TOKEN=
